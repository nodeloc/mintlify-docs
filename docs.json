{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Nodeloc  Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/nl-logo-green-square@180.png",
    "dark": "/images/nl-logo-green-square@180.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "使用指南",
        "groups": [
          {
            "group": "新手入门",
            "pages": [
              "index",
              "quickstart",
              "getting-started/account",
              "getting-started/posting"
            ]
          },
          {
            "group": "等级与能量",
            "pages": [
              "level",
              "energy/points",
              "energy/checkin"
            ]
          },
          {
            "group": "互动玩法",
            "pages": [
              "features/lottery",
              "features/red-envelope",
              "features/reward",
              "features/hidden-content",
              "features/read-permission"
            ]
          },
          {
            "group": "社区功能",
            "pages": [
              "community/nodes",
              "community/chat",
              "community/projects",
              "community/leaderboards"
            ]
          },
          {
            "group": "账号与通知",
            "pages": [
              "common/telegram",
              "account/preferences"
            ]
          },
          {
            "group": "推广与商业",
            "pages": [
              "promotion/ads",
              "promotion/merchants"
            ]
          },
          {
            "group": "帮助与共建",
            "pages": [
              "faq",
              "create"
            ]
          }
        ]
      },
      {
        "tab": "开发者文档",
        "groups": [
          {
            "group": "API 对接",
            "pages": [
              "api-reference/introduction",
              "api-reference/payment"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "论坛",
          "href": "https://www.nodeloc.com",
          "icon": "comments"
        },
        {
          "anchor": "博客",
          "href": "https://blog.nodeloc.com",
          "icon": "newspaper"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nodeloc/mintlify-docs",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/common/lottery",
      "destination": "/features/lottery"
    },
    {
      "source": "/common/payment",
      "destination": "/api-reference/payment"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/"
    },
    {
      "source": "/snippets/:slug*",
      "destination": "/"
    }
  ],
  "logo": {
    "light": "/images/nodeloc-wordmark-duotone@1024.png",
    "dark": "/images/nodeloc-wordmark-duotone@1024.png",
    "href": "https://www.nodeloc.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:james@nodeloc.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Forum",
      "href": "https://www.nodeloc.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nodeloc",
      "github": "https://github.com/nodeloc"
    }
  },
  "icons": {
    "library": "lucide"
  }
}
